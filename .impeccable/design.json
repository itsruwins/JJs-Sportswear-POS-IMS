      "html": "<nav class=\"ds-nav\"><span class=\"ds-nav-mark\">J&amp;J</span><a href=\"#\">Custom orders</a><a href=\"#\">AI studio</a><a href=\"#\" class=\"ds-nav-cta\">Create account</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:8px;height:64px;padding:0 24px;background:var(--nav-bg,oklch(0.975 0.004 50/0.72));-webkit-backdrop-filter:blur(20px) saturate(170%);backdrop-filter:blur(20px) saturate(170%);font:400 0.9375rem Archivo,sans-serif}.ds-nav-mark{font-weight:800;font-variation-settings:'wdth' 62;color:var(--board-text,oklch(0.255 0.012 50));margin-right:16px}.ds-nav a{padding:8px 12px;border-radius:999px;color:var(--ink-2,oklch(0.45 0.014 50));text-decoration:none;transition:color 150ms}.ds-nav a:hover{color:var(--ink,oklch(0.21 0.012 50))}.ds-nav a.ds-nav-cta{margin-left:auto;padding:8px 16px;background:var(--board,oklch(0.255 0.012 50));color:var(--board-ink,oklch(0.975 0.006 70));font-weight:600}.ds-nav a.ds-nav-cta:hover{background:var(--board-deep,oklch(0.205 0.01 50))}@media (prefers-reduced-transparency:reduce){.ds-nav{background:var(--ground,oklch(0.975 0.006 70));backdrop-filter:none;-webkit-backdrop-filter:none}}"
