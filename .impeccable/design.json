      "css": ".ds-board-swatch{background:var(--board,oklch(0.255 0.012 50));padding:20px;border-radius:16px}.ds-btn-card{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 20px;border:0;border-radius:12px;background:var(--card,oklch(0.985 0.004 70));color:var(--card-ink,oklch(0.18 0.01 50));font:600 1rem Archivo,ui-sans-serif,system-ui,sans-serif;box-shadow:0 1px 0 oklch(1 0 0/0.6) inset,0 6px 14px -6px oklch(0 0 0/0.45);cursor:pointer;transition:transform 120ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-card:focus-visible{outline:2px solid var(--focus,oklch(0.565 0.19 37.5));outline-offset:3px}.ds-btn-card:active{transform:translateY(1px) scale(0.975);transition-duration:60ms}"
    },
