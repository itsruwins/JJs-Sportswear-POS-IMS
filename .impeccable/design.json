    {
      "name": "Action Button",
      "kind": "button",
      "refersTo": "button-action",
      "description": "The one main action on a screen: Action Orange pill, white text, press travel.",
      "html": "<button class=\"ds-btn-action\">Create account</button>",
      "css": ".ds-btn-action{background:var(--action,oklch(0.565 0.19 37.5));color:var(--action-ink,oklch(1 0 0));border:0;border-radius:999px;padding:8px 16px;font:600 0.9375rem/1.4 Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:transform 120ms cubic-bezier(0.22,1,0.36,1),background-color 160ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-action:hover{background:var(--action-deep,oklch(0.5 0.17 37.5))}.ds-btn-action:focus-visible{outline:2px solid var(--focus,oklch(0.565 0.19 37.5));outline-offset:3px}.ds-btn-action:active{transform:translateY(1px) scale(0.975);transition-duration:60ms}@media (prefers-reduced-motion:reduce){.ds-btn-action:active{transform:none}}"
    },
    {
