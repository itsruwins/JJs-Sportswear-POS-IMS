      "html": "<div class=\"ds-board\"><div class=\"ds-well\"><span class=\"ds-flap\">R</span><span class=\"ds-flap\">E</span><span class=\"ds-flap\">A</span><span class=\"ds-flap\">D</span><span class=\"ds-flap\">Y</span><span class=\"ds-flap ds-blank\">&nbsp;</span></div></div>",
      "css": ".ds-board{padding:24px;border-radius:1.75rem;color:var(--board-ink,oklch(0.975 0.006 70));background:radial-gradient(120% 80% at 50% -10%,oklch(1 0 0/0.07),transparent 60%),var(--board,oklch(0.255 0.012 50));box-shadow:0 1px 0 oklch(1 0 0/0.12) inset,0 30px 60px -30px oklch(0.25 0.02 50/0.55),0 12px 24px -12px oklch(0.25 0.02 50/0.35)}.ds-well{display:flex;justify-content:center;gap:.06em;padding:16px 12px;border-radius:16px;background:var(--board-deep,oklch(0.205 0.01 50));box-shadow:inset 0 2px 6px oklch(0 0 0/0.28),0 1px 0 oklch(1 0 0/0.08);font:800 3.6rem/1 Archivo,sans-serif;font-variation-settings:'wdth' 62;font-variant-numeric:tabular-nums;letter-spacing:-.01em}.ds-flap{position:relative;display:inline-block;width:.72em;height:1em;line-height:1em;text-align:center;border-radius:.09em;color:var(--card-ink,oklch(0.18 0.01 50));background:linear-gradient(to bottom,var(--card,oklch(0.985 0.004 70)),var(--card-shade,oklch(0.93 0.006 70)) 50%,var(--card,oklch(0.985 0.004 70)) 50%)}.ds-flap::after{content:'';position:absolute;left:0;right:0;top:calc(50% - .5px);height:1px;background:oklch(0.2 0.02 50/0.35)}.ds-blank{opacity:.22}"
